{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ant-compile",
            "type": "shell",
            "command": "ant",
            "args": ["compile"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "ant-clean",
            "type": "shell",
            "command": "ant",
            "args": ["delete"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "run-mjtest",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "bin;lib/cup_v10k.jar;lib/JFlex.jar;lib/log4j-1.2.17.jar;lib/symboltable.jar;lib/mj-runtime.jar;config",
                "rs.ac.bg.etf.pp1.MJTest"
            ],
            "dependsOn": ["ant-compile"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "run-mjparsertest",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "bin;lib/cup_v10k.jar;lib/JFlex.jar;lib/log4j-1.2.17.jar;lib/symboltable.jar;lib/mj-runtime.jar;config",
                "rs.ac.bg.etf.pp1.MJParserTest"
            ],
            "dependsOn": ["ant-compile"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
