package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:
    boolean errorDetected = false;
    Logger log = Logger.getLogger(getClass());

    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
        done_parsing();
        report_error(message, info);
    }

    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }

    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
        errorDetected = true;
        StringBuilder msg = new StringBuilder(message);
        if (info instanceof Symbol)
            msg.append(" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }

    public void report_info(String message, Object info) {
        StringBuilder msg = new StringBuilder(message);
        if (info instanceof Symbol)
            msg.append(" na liniji ").append(((Symbol)info).left);
        log.info(msg.toString());
    }
:}

scan with {:
    Symbol s = this.getScanner().next_token();
    if (s != null && s.value != null)
        log.info(s.toString() + " " + s.value.toString());
    return s;
:}

terminal PROG, PRINT, RETURN, VOID;
terminal PLUS, EQUAL, SEMI, COMMA, LPAREN, RPAREN, LBRACE, RBRACE;
terminal MINUS, MUL, DIV, MODUL;
terminal EQUALS, NOTEQUALS, GREATER, GREATEREQUAL, LESS, LESSEQUAL;
terminal AND, OR, INC, DEC;
terminal COLON, FULLSTOP, LBRACK, RBRACK, QMARK;
terminal BREAK, ENUM, CLASS, ABSTRACT, IF, ELSE, CONST, NEW, READ;
terminal EXTENDS, CONTINUE, FOR, LENGTH, SWITCH, CASE;
terminal Integer NUMBER;
terminal String IDENT;
terminal Character CHAR;
terminal Integer BOOL;


// Neterminali bez tipa (sintaksne konstrukcije)
nonterminal MethodDeclList MethodDeclList;
nonterminal VarDeclList VarDeclList;
nonterminal VarDecl VarDecl;
nonterminal VarDeclIdentList VarDeclIdentList;
nonterminal VarDeclIdent VarDeclIdent;
nonterminal ConstDecl ConstDecl;
nonterminal ConstDeclList ConstDeclList;
nonterminal ConstAssign ConstAssign;
nonterminal ConstValue ConstValue;
nonterminal EnumDecl EnumDecl;
nonterminal EnumConstList EnumConstList;
nonterminal EnumConst EnumConst;
nonterminal ClassDecl ClassDecl;
nonterminal ClassBody ClassBody;
nonterminal Extends Extends;
nonterminal AbstractClassDecl AbstractClassDecl;
nonterminal AbstractBody AbstractBody;
nonterminal AbstractMethodOrMethodList AbstractMethodOrMethodList;
nonterminal AbstractMethodOrMethod AbstractMethodOrMethod;
nonterminal AbstractMethodDecl AbstractMethodDecl;
nonterminal FormalParamList FormalParamList;
nonterminal FormalParamDecl FormalParamDecl;
nonterminal FormPars FormPars;
nonterminal ActPars ActPars;
nonterminal StatementList StatementList;
nonterminal Statement Statement;
nonterminal Unmatched Unmatched;
nonterminal Matched Matched;
nonterminal AllDeclList AllDeclList;
nonterminal DesignatorStatement DesignatorStatement;
nonterminal Assignop Assignop;
nonterminal Condition Condition;
nonterminal ConditionList ConditionList;
nonterminal CondTerm CondTerm;
nonterminal CondFactList CondFactList;
nonterminal CondFact CondFact;
nonterminal ExprTern ExprTern;
nonterminal TernCondDone TernCondDone;
nonterminal TernThenDone TernThenDone;
nonterminal DesignatorList DesignatorList;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal Relop Relop;
nonterminal OptDesignatorStmt OptDesignatorStmt;
nonterminal OptCondition OptCondition;
nonterminal CaseList CaseList;
nonterminal CaseStmt CaseStmt;

// Neterminali sa tipom Obj (simboli)
nonterminal rs.etf.pp1.symboltable.concepts.Obj Program, ProgName, Designator, MethodDecl, MethodTypeName;

// Neterminali sa tipom Struct (tipovi)
nonterminal rs.etf.pp1.symboltable.concepts.Struct Type, Term, Expr, Factor, ExprNonTern, ExprNonTernList, TermList;

start with Program;

// ============ PROGRAM ============

Program ::= (Program) PROG ProgName:p AllDeclList:A1 LBRACE MethodDeclList:M2 RBRACE {: RESULT=new Program(p, A1, M2); RESULT.setLine(pleft); :} 
;

ProgName ::= (ProgName) IDENT:pName {: RESULT=new ProgName(pName); RESULT.setLine(pNameleft); :} 
;

// ============ GLOBALNE DEKLARACIJE ============

AllDeclList ::= (ConstDeclaration) AllDeclList:A1 ConstDecl:C2 {: RESULT=new ConstDeclaration(A1, C2); RESULT.setLine(A1left); :}
|
(VarDeclaration) AllDeclList:A1 VarDecl:V2 {: RESULT=new VarDeclaration(A1, V2); RESULT.setLine(A1left); :}
|
(ClassDeclaration) AllDeclList:A1 ClassDecl:C2 {: RESULT=new ClassDeclaration(A1, C2); RESULT.setLine(A1left); :}
|
(EnumDeclaration) AllDeclList:A1 EnumDecl:E2 {: RESULT=new EnumDeclaration(A1, E2); RESULT.setLine(A1left); :}
|
(AbstractClassDeclaration) AllDeclList:A1 AbstractClassDecl:A2 {: RESULT=new AbstractClassDeclaration(A1, A2); RESULT.setLine(A1left); :}
|
(NoDeclaration) {: RESULT=new NoDeclaration(); :} /* epsilon */
;

// ============ PROMENLJIVE ============

VarDeclList ::= (VarDeclarations) VarDeclList:V1 VarDecl:V2 {: RESULT=new VarDeclarations(V1, V2); RESULT.setLine(V1left); :}  
|
(NoVarDecl) {: RESULT=new NoVarDecl(); :} /* epsilon */ 
;

VarDecl ::= (VarDeclCorrect) Type:varType VarDeclIdentList:V1 SEMI {: RESULT=new VarDeclCorrect(varType, V1); RESULT.setLine(varTypeleft); :}
  |
  (VarDeclError) error SEMI
  {: parser.report_error("Greska u deklaraciji promenljive", null); :} {: RESULT=new VarDeclError(); :}
  |
  (VarDeclErrorComma) error COMMA
  {: parser.report_error("Greska u deklaraciji promenljive", null); :} {: RESULT=new VarDeclErrorComma(); :}
  ;

VarDeclIdentList ::= (SingleVarIdent) VarDeclIdent:V1 {: RESULT=new SingleVarIdent(V1); RESULT.setLine(V1left); :}
   |
   (MultiVarIdent) VarDeclIdentList:V1 COMMA VarDeclIdent:V2 {: RESULT=new MultiVarIdent(V1, V2); RESULT.setLine(V1left); :}
   ;

VarDeclIdent ::= (ScalarVar) IDENT:varName {: RESULT=new ScalarVar(varName); RESULT.setLine(varNameleft); :}
   |
   (ArrayVar) IDENT:varName LBRACK RBRACK {: RESULT=new ArrayVar(varName); RESULT.setLine(varNameleft); :}
   ;

// ============ KONSTANTE ============

ConstDecl ::= (ConstDecl) CONST Type:constType ConstDeclList:C1 SEMI {: RESULT=new ConstDecl(constType, C1); RESULT.setLine(constTypeleft); :} 
;

ConstDeclList ::= (SingleConstDecl) ConstAssign:C1 {: RESULT=new SingleConstDecl(C1); RESULT.setLine(C1left); :}
|
(MultiConstDecl) ConstDeclList:C1 COMMA ConstAssign:C2 {: RESULT=new MultiConstDecl(C1, C2); RESULT.setLine(C1left); :}
;

ConstAssign ::= (ConstAssign) IDENT:constName EQUAL ConstValue:C1 {: RESULT=new ConstAssign(constName, C1); RESULT.setLine(constNameleft); :} 
;

ConstValue ::= (NumConstValue) NUMBER:numVal {: RESULT=new NumConstValue(numVal); RESULT.setLine(numValleft); :}
 |
 (CharConstValue) CHAR:charVal {: RESULT=new CharConstValue(charVal); RESULT.setLine(charValleft); :}
 |
 (BoolConstValue) BOOL:boolVal {: RESULT=new BoolConstValue(boolVal); RESULT.setLine(boolValleft); :}
 ;

// ============ NABRAJANJA ============

EnumDecl ::= (EnumDecl) ENUM IDENT:enumName LBRACE EnumConstList:E1 RBRACE {: RESULT=new EnumDecl(enumName, E1); RESULT.setLine(enumNameleft); :} 
;

EnumConstList ::= (SingleEnumConst) EnumConst:E1 {: RESULT=new SingleEnumConst(E1); RESULT.setLine(E1left); :}
|
(MultiEnumConst) EnumConstList:E1 COMMA EnumConst:E2 {: RESULT=new MultiEnumConst(E1, E2); RESULT.setLine(E1left); :}
;

EnumConst ::= (EnumConstSimple) IDENT:enumConstName {: RESULT=new EnumConstSimple(enumConstName); RESULT.setLine(enumConstNameleft); :}
|
(EnumConstWithValue) IDENT:enumConstName EQUAL NUMBER:enumVal {: RESULT=new EnumConstWithValue(enumConstName, enumVal); RESULT.setLine(enumConstNameleft); :}
;

// ============ KLASE ============

ClassDecl ::= (ClassDecl) CLASS IDENT:className Extends:E1 LBRACE VarDeclList:V2 ClassBody:C3 RBRACE {: RESULT=new ClassDecl(className, E1, V2, C3); RESULT.setLine(classNameleft); :} 
;

AbstractClassDecl ::= (AbstractClassDecl) ABSTRACT CLASS IDENT:className Extends:E1 LBRACE VarDeclList:V2 AbstractBody:A3 RBRACE {: RESULT=new AbstractClassDecl(className, E1, V2, A3); RESULT.setLine(classNameleft); :} 
;

Extends ::= (ExtendsType) EXTENDS Type:parentType {: RESULT=new ExtendsType(parentType); RESULT.setLine(parentTypeleft); :}
  |
  (NoExtends) {: RESULT=new NoExtends(); :} /* epsilon */
  ;

ClassBody ::= (ClassBodyMethods) LBRACE MethodDeclList:M1 RBRACE {: RESULT=new ClassBodyMethods(M1); RESULT.setLine(M1left); :}
|
(NoClassBody) {: RESULT=new NoClassBody(); :} /* epsilon */
;

AbstractBody ::= (AbstractBodyMethods) LBRACE AbstractMethodOrMethodList:A1 RBRACE {: RESULT=new AbstractBodyMethods(A1); RESULT.setLine(A1left); :}
   |
   (NoAbstractBody) {: RESULT=new NoAbstractBody(); :} /* epsilon */
   ;

AbstractMethodOrMethodList ::= (AbstractMethodOrMethods) AbstractMethodOrMethodList:A1 AbstractMethodOrMethod:A2 {: RESULT=new AbstractMethodOrMethods(A1, A2); RESULT.setLine(A1left); :}
 |
 (NoAbstractMethodOrMethod) {: RESULT=new NoAbstractMethodOrMethod(); :} /* epsilon */
 ;

AbstractMethodOrMethod ::= (ConcreteMethodInAbstract) MethodDecl:M1 {: RESULT=new ConcreteMethodInAbstract(M1); RESULT.setLine(M1left); :}
 |
 (AbstractMethodInAbstract) AbstractMethodDecl:A1 SEMI {: RESULT=new AbstractMethodInAbstract(A1); RESULT.setLine(A1left); :}
 ;

AbstractMethodDecl ::= (AbstractMethodDeclType) ABSTRACT Type:retType IDENT:methName LPAREN FormPars:F1 RPAREN {: RESULT=new AbstractMethodDeclType(retType, methName, F1); RESULT.setLine(retTypeleft); :}
 |
 (AbstractMethodDeclVoid) ABSTRACT VOID IDENT:methName LPAREN FormPars:F1 RPAREN {: RESULT=new AbstractMethodDeclVoid(methName, F1); RESULT.setLine(methNameleft); :}
 ;

// ============ TIP ============

Type ::= (Type) IDENT:typeName {: RESULT=new Type(typeName); RESULT.setLine(typeNameleft); :} 
;

// ============ METODE ============

MethodDeclList ::= (MethodDeclarations) MethodDeclList:M1 MethodDecl:M2 {: RESULT=new MethodDeclarations(M1, M2); RESULT.setLine(M1left); :}
|
(NoMethodDecl) {: RESULT=new NoMethodDecl(); :} /* epsilon */
;

MethodDecl ::= (MethodDecl) MethodTypeName:M1
   LPAREN FormPars:F2 RPAREN VarDeclList:V3 LBRACE StatementList:S4 RBRACE {: RESULT=new MethodDecl(M1, F2, V3, S4); RESULT.setLine(M1left); :} 
   ;

MethodTypeName ::= (TypeMethodTypeName) Type:retType IDENT:methName {: RESULT=new TypeMethodTypeName(retType, methName); RESULT.setLine(retTypeleft); :}
 |
 (VoidMethodTypeName) VOID IDENT:methName {: RESULT=new VoidMethodTypeName(methName); RESULT.setLine(methNameleft); :}
 ;

// ============ PARAMETRI ============

FormPars ::= (FormParams) FormalParamList:F1 {: RESULT=new FormParams(F1); RESULT.setLine(F1left); :} | (NoFormParam) {: RESULT=new NoFormParam(); :} /* epsilon */ ;

FormalParamList ::= (FormalParamDecls) FormalParamList:F1 COMMA FormalParamDecl:F2 {: RESULT=new FormalParamDecls(F1, F2); RESULT.setLine(F1left); :}
|
(SingleFormalParamDecl) FormalParamDecl:F1 {: RESULT=new SingleFormalParamDecl(F1); RESULT.setLine(F1left); :}
;

FormalParamDecl ::= (ScalarFormalParam) Type:T1 IDENT:I2 {: RESULT=new ScalarFormalParam(T1, I2); RESULT.setLine(T1left); :}
  |
  (ArrayFormalParam) Type:T1 IDENT:I2 LBRACK RBRACK {: RESULT=new ArrayFormalParam(T1, I2); RESULT.setLine(T1left); :}
  ;

// ============ ISKAZI ============

StatementList ::= (Statements) StatementList:S1 Statement:S2 {: RESULT=new Statements(S1, S2); RESULT.setLine(S1left); :} 
|
  (NoStmt) {: RESULT=new NoStmt(); :} /* epsilon */
  ;

Statement ::= (MatchedStmt) Matched:M1 {: RESULT=new MatchedStmt(M1); RESULT.setLine(M1left); :} | (UnmachedStmt) Unmatched:U1 {: RESULT=new UnmachedStmt(U1); RESULT.setLine(U1left); :} ;

Unmatched ::= (UnmatchedIf) IF LPAREN Condition:C1 RPAREN Statement:S2 {: RESULT=new UnmatchedIf(C1, S2); RESULT.setLine(C1left); :} 
| (UnmatchedIfElse) IF LPAREN Condition:C1 RPAREN Matched:M2 ELSE Unmatched:U3 {: RESULT=new UnmatchedIfElse(C1, M2, U3); RESULT.setLine(C1left); :}
| (UnmatchedFor) FOR LPAREN OptDesignatorStmt:O1 SEMI OptCondition:O2 SEMI OptDesignatorStmt:O3 RPAREN Unmatched:U4 {: RESULT=new UnmatchedFor(O1, O2, O3, U4); RESULT.setLine(O1left); :}
;

Matched ::= (MatchedDesignStmt) DesignatorStatement:D1 SEMI {: RESULT=new MatchedDesignStmt(D1); RESULT.setLine(D1left); :} 
  |
  (ErrAssignment) error SEMI
  {: parser.report_error("Greska u iskazu dodele", null); :} {: RESULT=new ErrAssignment(); :}
  |
  (PrintStmt) PRINT LPAREN Expr:E1 RPAREN SEMI {: RESULT=new PrintStmt(E1); RESULT.setLine(E1left); :} 
  |
  (PrintStmtNum) PRINT LPAREN Expr:E1 COMMA NUMBER:N2 RPAREN SEMI {: RESULT=new PrintStmtNum(E1, N2); RESULT.setLine(E1left); :}
  |
  (ReadStmt) READ LPAREN Designator:D1 RPAREN SEMI {: RESULT=new ReadStmt(D1); RESULT.setLine(D1left); :}
  |
  (ReturnExpr) RETURN Expr:t SEMI {: RESULT=new ReturnExpr(t); RESULT.setLine(tleft); :}
  |
  (ReturnNoExpr) RETURN SEMI {: RESULT=new ReturnNoExpr(); :}
  | 
  (MatchedIf) IF LPAREN Condition:C1 RPAREN Matched:M2 ELSE Matched:M3 {: RESULT=new MatchedIf(C1, M2, M3); RESULT.setLine(C1left); :}
  |
  (BreakStmt) BREAK SEMI {: RESULT=new BreakStmt(); :}
  |
  (ContinueStmt) CONTINUE SEMI {: RESULT=new ContinueStmt(); :}
  |
  (SwitchStmt) SWITCH LPAREN Expr:E1 RPAREN LBRACE CaseList:C2 RBRACE {: RESULT=new SwitchStmt(E1, C2); RESULT.setLine(E1left); :}
  |
  (MatchedFor) FOR LPAREN OptDesignatorStmt:O1 SEMI OptCondition:O2 SEMI OptDesignatorStmt:O3 RPAREN Matched:M4 {: RESULT=new MatchedFor(O1, O2, O3, M4); RESULT.setLine(O1left); :}
  |
  (BlockStmt) LBRACE StatementList:S1 RBRACE {: RESULT=new BlockStmt(S1); RESULT.setLine(S1left); :}
  ;

// ============ DESIGNATOR STATEMENT ============
  
DesignatorStatement ::= (Assignment) Designator:D1 Assignop:A2 Expr:E3 {: RESULT=new Assignment(D1, A2, E3); RESULT.setLine(D1left); :}
|
(ProcCall) Designator:D1 LPAREN RPAREN {: RESULT=new ProcCall(D1); RESULT.setLine(D1left); :} 
|
(ProcCallPars) Designator:D1 LPAREN ActPars:A2 RPAREN {: RESULT=new ProcCallPars(D1, A2); RESULT.setLine(D1left); :} 
|
(Increment) Designator:D1 INC {: RESULT=new Increment(D1); RESULT.setLine(D1left); :}
|
(Decrement) Designator:D1 DEC {: RESULT=new Decrement(D1); RESULT.setLine(D1left); :}
;

// ============ FOR / SWITCH POMOCNI ============

OptDesignatorStmt ::= (OptDesignStmt) DesignatorStatement:D1 {: RESULT=new OptDesignStmt(D1); RESULT.setLine(D1left); :}
|
(NoOptDesignStmt) {: RESULT=new NoOptDesignStmt(); :} /* epsilon */
;

OptCondition ::= (OptCond) Condition:C1 {: RESULT=new OptCond(C1); RESULT.setLine(C1left); :}
   |
   (NoOptCond) {: RESULT=new NoOptCond(); :} /* epsilon */
   ;

CaseList ::= (CaseItems) CaseList:C1 CaseStmt:C2 {: RESULT=new CaseItems(C1, C2); RESULT.setLine(C1left); :}
   |
   (NoCaseItems) {: RESULT=new NoCaseItems(); :} /* epsilon */
   ;

CaseStmt ::= (CaseStmt) CASE NUMBER:caseVal COLON StatementList:S1 {: RESULT=new CaseStmt(caseVal, S1); RESULT.setLine(caseValleft); :} 
;

// ============ STVARNI PARAMETRI ============

ActPars ::= (ActParsList) ActPars:A1 COMMA Expr:E2 {: RESULT=new ActParsList(A1, E2); RESULT.setLine(A1left); :}
|
(ActParsSingle) Expr:E1 {: RESULT=new ActParsSingle(E1); RESULT.setLine(E1left); :}
;

// ============ USLOVI ============

Condition ::= (Condition) ConditionList:C1 {: RESULT=new Condition(C1); RESULT.setLine(C1left); :} 
;

ConditionList ::= (OneCondTerm) CondTerm:C1 {: RESULT=new OneCondTerm(C1); RESULT.setLine(C1left); :}
|
(CondTerms) ConditionList:C1 OR CondTerm:C2 {: RESULT=new CondTerms(C1, C2); RESULT.setLine(C1left); :}
;

CondTerm ::= (CondTerm) CondFactList:C1 {: RESULT=new CondTerm(C1); RESULT.setLine(C1left); :} 
;

CondFactList ::= (MultiCondFact) CondFactList:C1 AND CondFact:C2 {: RESULT=new MultiCondFact(C1, C2); RESULT.setLine(C1left); :}
   |
   (SingleCondFact) CondFact:C1 {: RESULT=new SingleCondFact(C1); RESULT.setLine(C1left); :}
   ;

CondFact ::= (SimpleCondFact) ExprNonTern:E1 {: RESULT=new SimpleCondFact(E1); RESULT.setLine(E1left); :}
   |
   (RelopCondFact) ExprNonTern:E1 Relop:R2 ExprNonTern:E3 {: RESULT=new RelopCondFact(E1, R2, E3); RESULT.setLine(E1left); :}
   ;

// ============ IZRAZI ============

Expr ::= (NonTernExpr) ExprNonTern:E1 {: RESULT=new NonTernExpr(E1); RESULT.setLine(E1left); :}
 |
 (TernExpr) ExprTern:E1 {: RESULT=new TernExpr(E1); RESULT.setLine(E1left); :}
 ;

ExprNonTern ::= (ExprNonTern) ExprNonTernList:E1 {: RESULT=new ExprNonTern(E1); RESULT.setLine(E1left); :} 
;

ExprNonTernList ::= (AddExpr) ExprNonTernList:E1 Addop:A2 Term:t1 {: RESULT=new AddExpr(E1, A2, t1); RESULT.setLine(E1left); :}
|
(MinusExpr) MINUS Term:t {: RESULT=new MinusExpr(t); RESULT.setLine(tleft); :} 
|
(TermExpr) Term:t {: RESULT=new TermExpr(t); RESULT.setLine(tleft); :}
;

TernCondDone ::= (TernCondDone) {: RESULT=new TernCondDone(); :} /* epsilon */
;

TernThenDone ::= (TernThenDone) {: RESULT=new TernThenDone(); :} /* epsilon */
;

ExprTern ::= (TernaryExpr) Condition:c QMARK TernCondDone:T1 Expr:e1 TernThenDone:T2 COLON Expr:e2 {: RESULT=new TernaryExpr(c, T1, e1, T2, e2); RESULT.setLine(cleft); :}
 ;

// ============ TERM ============

Term ::= (Term) TermList:T1 {: RESULT=new Term(T1); RESULT.setLine(T1left); :} 
;

TermList ::= (MulExpr) TermList:T1 Mulop:M2 Factor:f {: RESULT=new MulExpr(T1, M2, f); RESULT.setLine(T1left); :}
   |
   (SingleFactor) Factor:f {: RESULT=new SingleFactor(f); RESULT.setLine(fleft); :}
   ;

// ============ FAKTOR ============

Factor ::= (NumConst) NUMBER:numVal {: RESULT=new NumConst(numVal); RESULT.setLine(numValleft); :}
|
   (Var) Designator:d {: RESULT=new Var(d); RESULT.setLine(dleft); :}
    |
   (FuncCall) Designator:func LPAREN ActPars:A1 RPAREN {: RESULT=new FuncCall(func, A1); RESULT.setLine(funcleft); :}
   |
   (FuncCallNoPars) Designator:func LPAREN RPAREN {: RESULT=new FuncCallNoPars(func); RESULT.setLine(funcleft); :}
   |
   (CharConst) CHAR:charVal {: RESULT=new CharConst(charVal); RESULT.setLine(charValleft); :}
   |
   (BoolConst) BOOL:boolVal {: RESULT=new BoolConst(boolVal); RESULT.setLine(boolValleft); :}
   |
   (NewObj) NEW Type:type {: RESULT=new NewObj(type); RESULT.setLine(typeleft); :}
   |
   (NewArray) NEW Type:type LBRACK Expr:expr RBRACK {: RESULT=new NewArray(type, expr); RESULT.setLine(typeleft); :}
   |
   (ParenExpr) LPAREN Expr:expr RPAREN {: RESULT=new ParenExpr(expr); RESULT.setLine(exprleft); :}
   ;

// ============ DESIGNATOR ============

Designator ::= (Designator) DesignatorList:D1 {: RESULT=new Designator(D1); RESULT.setLine(D1left); :} 
;

DesignatorList ::= (DesignatorIdent) IDENT:name {: RESULT=new DesignatorIdent(name); RESULT.setLine(nameleft); :}
 |
 (DesignatorField) DesignatorList:D1 FULLSTOP IDENT:name {: RESULT=new DesignatorField(D1, name); RESULT.setLine(D1left); :}
 |
 (DesignatorLength) DesignatorList:D1 FULLSTOP LENGTH {: RESULT=new DesignatorLength(D1); RESULT.setLine(D1left); :}
 |
 (DesignatorArray) DesignatorList:D1 LBRACK Expr:e RBRACK {: RESULT=new DesignatorArray(D1, e); RESULT.setLine(D1left); :}
 ;

// ============ OPERATORI ============

Assignop ::= (Assignop) EQUAL {: RESULT=new Assignop(); :} 
;

Relop ::= (Equalsop) EQUALS {: RESULT=new Equalsop(); :}
|
(Notequalsop) NOTEQUALS {: RESULT=new Notequalsop(); :}
|
(Greaterop) GREATER {: RESULT=new Greaterop(); :}
|
(Greaterequalop) GREATEREQUAL {: RESULT=new Greaterequalop(); :}
|
(Lessop) LESS {: RESULT=new Lessop(); :}
|
(Lessequalop) LESSEQUAL {: RESULT=new Lessequalop(); :}
;

Addop ::= (PlusOp) PLUS {: RESULT=new PlusOp(); :}
|
(SubOp) MINUS {: RESULT=new SubOp(); :}
;

Mulop ::= (TimesOp) MUL {: RESULT=new TimesOp(); :}
|
(DivOp) DIV {: RESULT=new DivOp(); :}
|
(ModOp) MODUL {: RESULT=new ModOp(); :}
;
